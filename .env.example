# Supabase — from your project's API settings (Project Settings → API).
# The anon key is safe in the browser: row-level security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses EVERY row-level security policy, so it must never be
# prefixed NEXT_PUBLIC_ and never referenced from a client component.
# Used in Phase 2 by the approval-decision route, which verifies an emailed
# token for a guide who is not signed in.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email for approval requests (Phase 2).
# Needs a verified sending domain; see README.
RESEND_API_KEY=
APPROVAL_FROM_EMAIL=rooms@alpha.school

# Used to build absolute links in approval emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Slack — "Message on Slack" on the People page. Both optional: without them the
# button simply doesn't render.
# Team id: the T… segment in any Slack URL, e.g. https://app.slack.com/client/T0123ABCD/…
NEXT_PUBLIC_SLACK_TEAM_ID=
# Bot token (xoxb-…) from a Slack app installed to the workspace, with the
# users:read and users:read.email scopes. Server-only; never NEXT_PUBLIC_.
SLACK_BOT_TOKEN=
